[mysqld]
expire_logs_days=7
innodb_buffer_pool_size = 256M
sort_buffer_size = 1M
join_buffer_size = 1M
max_connections = 50
tmp_table_size = 16M
max_heap_table_size = 16M
innodb_redo_log_capacity = 50M

# --- Optimización para entornos DEV con RAM limitada ---
# Desactiva el Performance Schema para ahorrar ~300MB-400MB de RAM de golpe
performance_schema = OFF

# Desactiva caches no esenciales en local
skip-name-resolve

